FROM mcr.microsoft.com/playwright:v1.58.2-noble AS playwright_browsers

FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        fonts-liberation \
        git \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        make \
        openssh-client \
        python3 \
        python3-pip \
        xdg-utils \
    && rm -rf /var/lib/apt/lists/*

ENV UV_INSTALL_DIR=/usr/local/bin
ENV PATH=/home/vscode/.local/bin:${PATH}
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

COPY --from=playwright_browsers /ms-playwright/ /ms-playwright/

RUN useradd --create-home --shell /bin/bash vscode \
    && mkdir -p /workspace /home/vscode/.codex /home/vscode/.npm \
    && chown -R vscode:vscode /workspace /home/vscode /ms-playwright

WORKDIR /workspace
USER vscode
